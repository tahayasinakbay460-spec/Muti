# Bu dosyayı ".env" adıyla kopyala ve değerleri doldur. ".env" asla git'e eklenmez.

# JWT imzalama anahtarı (zorunlu, en az 32 karakter). Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# development | production
ENVIRONMENT=development

# Sunucunun dinlediği adres. 127.0.0.1: yalnızca bu bilgisayar.
# 0.0.0.0: aynı Wi-Fi'daki telefon da girebilir (adres: http://<bilgisayarın IP'si>:5500).
HOST=127.0.0.1

# Demo: SQLite. Canlı: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./app.db

# İzin verilen frontend adresleri (JSON listesi). Canlıda "*" olmaz.
CORS_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500"]

# true: örnek veriyi yükler ve ödeme doğrulaması olmadan coin satın almaya izin verir.
# Canlıda mutlaka false olmalı.
DEMO_MODE=true

# ── Sesli görüşme (WebRTC) ── bkz. app/voice/
# mesh: tarayıcılar birbirine doğrudan bağlanır, ek sunucu gerekmez (odada ~30 kişiye kadar).
# livekit: açık kaynak medya sunucusu (kendi sunucumuz ya da LiveKit Cloud), kalabalık odalar için.
VOICE_PROVIDER=mesh
# STUN sunucuları (JSON listesi). Kendi coturn sunucumuz kurulunca onun adresi yazılır.
VOICE_STUN_URLS=["stun:stun.l.google.com:19302"]
# TURN (sıkı ağlarda sesi aktaran sunucu, ör. coturn). Boş bırakılırsa kullanılmaz.
# VOICE_TURN_URLS=["turn:turn.ornek.com:3478?transport=udp","turns:turn.ornek.com:5349"]
# coturn ayarındaki static-auth-secret ile aynı olmalı:
# VOICE_TURN_SECRET=
# Yalnızca VOICE_PROVIDER=livekit iken:
# LIVEKIT_URL=wss://ses.ornek.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
