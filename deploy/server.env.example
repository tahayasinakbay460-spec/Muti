# Sunucudaki deploy/.env dosyasının örneği. Kopyala: cp server.env.example .env
# Bu dosya GİZLİDİR: GitHub'a gönderilmez, kimseyle paylaşılmaz.

# Sitenin adresi (www olmadan). Alan adı yoksa sunucu IP'sinden: 1.2.3.4 → 1-2-3-4.sslip.io
DOMAIN=mutishow.tech

# Veritabanı parolası (uzun, rastgele). Üretmek için: openssl rand -hex 24
POSTGRES_PASSWORD=

# Giriş token'larını imzalayan anahtar. Üretmek için: openssl rand -hex 32
SECRET_KEY=

ENVIRONMENT=production
DEMO_MODE=false
# Vitrin: örnek odalar ve hesaplar (muti / demo1234) görünür; demo yönetici hesabı yok.
SHOWCASE_DATA=true
# Açık beta: coin paketleri ödeme alınmadan verilir.
FREE_COIN_PURCHASE=true

# Yönetim paneli hesabı (ilk açılışta oluşur). Güçlü bir parola seç.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_CAN_READ_MESSAGES=false

# Ses: Agora konsolundaki proje bilgileri
VOICE_PROVIDER=agora
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
