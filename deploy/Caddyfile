# Caddy: sitenin kapısı. Let's Encrypt'ten ücretsiz https sertifikasını kendisi alır ve
# süresi dolmadan kendisi yeniler. http ile gelenleri https'e yönlendirir.
# WebSocket (/ws/...) bağlantılarını da ayrıca ayar gerekmeden uygulamaya iletir.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000
}

# www.ornek.com ile gelenleri asıl adrese yönlendir (sertifikasını da Caddy alır)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
